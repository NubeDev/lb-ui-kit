{
  "name": "@nube/dash-kit",
  "version": "0.7.2",
  "description": "The Lazybones dashboard machinery \u2014 the read cache, the time-range picker, the source picker, insights, the panel and the nav rail \u2014 published as ONE kit an extension UI can consume. The host injects how to reach the node (a single leashed `(tool, args)` call), so the same code path drives the shell gateway OR an extension bridge.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NubeDev/lb-ui-kit.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/dash-kit.cjs",
  "module": "./dist/dash-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dash-kit.js",
      "require": "./dist/dash-kit.cjs"
    },
    "./style.css": "./dist/dash-kit.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/assert-single-copy.mjs && node scripts/assert-no-theme-block.mjs"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/query-core": "^5.101.4",
    "lucide-react": ">=0.4.0",
    "react": ">=18",
    "react-dom": ">=18",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.10"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": false
    },
    "echarts": {
      "//": "Optional: a consumer that never mounts an EChart never loads it (the wrapper dynamic-imports it), so it must not be forced to install ~1MB.",
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/query-core": "5.101.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "echarts": "^6.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "idb-keyval": "^6.3.0",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "idb-keyval": "^6.3.0"
  }
}
